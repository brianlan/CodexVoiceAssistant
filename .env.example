# Run ./scripts/setup.sh to create .env with random secrets and detected defaults.
APP_HOST_IP=192.168.1.10
APP_PORT=3000
APP_PASSWORD=replace-with-at-least-12-characters
APP_SERVER_TOKEN=replace-with-at-least-24-random-characters
SESSION_TTL_HOURS=12

# Exactly one host directory is mounted at /workspace inside Codex.
HOST_WORKSPACE=/absolute/path/to/your/project
HOST_CODEX_HOME=/absolute/path/to/.codex
HOST_GH_CONFIG=/absolute/path/to/.config/gh
HOST_UID=1000
HOST_GID=1000

# read-only | workspace-write | full-access | yolo
CODEX_PERMISSION_MODE=workspace-write
CODEX_VERSION=0.146.0
GH_VERSION=2.86.0
CODEX_MODEL=
# none | minimal | low | medium | high | xhigh | max | ultra
CODEX_REASONING_EFFORT=

# V3 Frameless Bidi / GPT-Live settings.
REALTIME_MODEL=gpt-live-1-boulder-alpha
REALTIME_VOICE=
REALTIME_PROMPT=

# Optional API-key authentication. Leave blank when mounting a logged-in CODEX_HOME.
# Project-specific names avoid inheriting unrelated host OPENAI_* variables.
CODEX_API_KEY=
CODEX_API_ENDPOINT=
CODEX_API_BASE_URL=

# Optional proxy reachable from inside Docker, e.g. http://host.docker.internal:7890.
CODEX_HTTP_PROXY=
CODEX_HTTPS_PROXY=
CODEX_NO_PROXY=localhost,127.0.0.1,codex-app-server,voice-assistant

# Only used with docker-compose.host-network.yml for a loopback-only host proxy.
CODEX_LOOPBACK_PROXY=
